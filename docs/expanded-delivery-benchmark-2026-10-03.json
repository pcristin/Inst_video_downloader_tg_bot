{
  "date": "2026-10-03",
  "purpose": "Expanded live validation of experimental authenticated metadata plus Telegram HTTP URL fetch versus locally implemented authenticated-first acquisition/download/normalization/upload.",
  "deployment": "Neither experiment nor local implementation was deployed by this benchmark.",
  "method": {
    "samples": "Eight most recent distinct reel URLs and four most recent distinct post URLs from historical live request state; deterministic shuffle seed 20261003. Nine URLs new to these experiments; three previously tested.",
    "trials": 24,
    "order": "Six pairs direct-first and six current-first; sequential trials; pair starts at least 10 seconds apart.",
    "accounts": "Twelve distinct initially eligible saved-session accounts, one pinned account/proxy per URL for both paths. Copied account state and sessions; production state untouched.",
    "destination": "Configured storage chat only, including final grouped sends using Telegram file IDs.",
    "runtime": "instagrapi 3.0.16 in isolated container using current source snapshot and production network namespace; 2 CPUs, 1 GB RAM.",
    "timer": "From immediately before Bot initialization to acknowledgement of all final Telegram media sends. Includes provider throttle, metadata, transfer and current-path normalization. Excludes incoming update handling/queueing, imports and outer child startup. process_wall_s includes outer process overhead and post-send baseline probing.",
    "direct": "Saved-session authenticated target-media request without standalone timeline validation; remote ffprobe checks H.264/yuv420p and AAC when present; Telegram fetches CDN URLs; staging concurrency two. No full decode or local media download. No fallback or storage RetryAfter retry in experimental branch.",
    "current": "Actual VideoDownloader, TelegramMediaStager and TelegramMediaSender, including bounded authenticated-first attempt, public fallback and normal storage retries.",
    "deadlines": "90 seconds per complete trial; remote probe 12 seconds; Telegram read timeout 40 seconds.",
    "harness_sha256": "c51e50ed372e0ebb495c6b0074590049951063c5e67b949418f0c944ca4eb488"
  },
  "limitations": [
    "Small convenience sample, one trial per URL/path; no production percentile/SLO claim or sustained concurrency/load validation.",
    "Bot result cache bypassed; historical links may already have Telegram/CDN caches. Alternating order reduces but does not eliminate cache/network bias.",
    "Photo selection differs: direct chooses largest candidate; baseline photo dimensions were not captured. Compare photo delivery latency as operational paths, not identical-quality encodes.",
    "Video dimensions/codecs recorded, but MP4 duration/bytes can differ after normalization. No full direct-source decode or physical-device playback validation.",
    "Success-only latency statistics exclude failures. Matched pairs exclude any pair with a failure, so do not imply standalone direct-path reliability.",
    "Failure classes/stages are recorded; generic Telegram BadRequest and Instagram UnknownError messages were suppressed, so exact underlying causes remain unverified.",
    "No combined direct-plus-fallback pipeline was measured; current success on a separate trial demonstrates availability of a fallback, not its integrated latency."
  ],

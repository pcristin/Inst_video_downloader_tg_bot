# Telegram Bot Configuration
# Development-only direct value. Production Compose reads the token from
# secrets/telegram_bot_token and must leave BOT_TOKEN unset.
BOT_TOKEN=your_telegram_bot_token_here
BOT_TOKEN_FILE=
# Telegram user ID that receives owner-only alerts and can use owner commands.
BOT_OWNER_USER_ID=
# Optional: send a one-time migration notice to historical users, e.g. igclipbot.
BOT_MIGRATION_TARGET_USERNAME=
# Optional: run this token as a redirect-only legacy bot during migration.
BOT_LEGACY_REDIRECT_MODE=false

# Local Telegram Bot API (optional; use docker-compose.local-api.yml).
# Store the bot token, api_id, and api_hash below the root-only secrets/
# directory. Do not put production credentials in .env.
TELEGRAM_LOCAL_MODE=false
TELEGRAM_BOT_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_BOT_API_BASE_FILE_URL=http://telegram-bot-api:8081/file/bot
# Application ceiling: 500 MiB. Cloud mode remains capped at 50 MiB.
TELEGRAM_MAX_UPLOAD_BYTES=524288000
# Delete local payloads larger than 50 MiB after Telegram returns a file_id.
TELEGRAM_LARGE_FILE_CACHE_THRESHOLD_BYTES=52428800

# Telegram media upload reliability
TELEGRAM_MEDIA_WRITE_TIMEOUT_SECONDS=60
TELEGRAM_MEDIA_READ_TIMEOUT_SECONDS=120
TELEGRAM_MEDIA_CONNECT_TIMEOUT_SECONDS=20
TELEGRAM_MEDIA_POOL_TIMEOUT_SECONDS=30
TELEGRAM_MEDIA_UPLOAD_RETRY_ATTEMPTS=2
TELEGRAM_MEDIA_UPLOAD_RETRY_BACKOFF_SECONDS=1
TELEGRAM_MEDIA_STORAGE_CHAT_ID=

# Account health automation
# Account is removed from usable rotation after this many sequential auth/download failures.
ACCOUNT_FAILURE_THRESHOLD=2
# Notify BOT_OWNER_USER_ID when usable Instagram accounts drop below this number.
ACCOUNT_LOW_WATERMARK=3
# Minimum seconds between low-account-pool DM alerts.
ACCOUNT_ALERT_COOLDOWN_SECONDS=3600
ACCOUNT_STATE_FILE=accounts_state.json

# Instagram Credentials
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Two-Factor Authentication (optional)
# Generate this by running: docker-compose run --rm instagram-video-bot python -m src.instagram_video_bot.setup_2fa
TOTP_SECRET=

# Fast Instagram extraction (default primary path)
IG_FAST_METHOD_ENABLED=true
IG_FAST_TIMEOUT_CONNECT=10
IG_FAST_TIMEOUT_READ=45
IG_AUTH_COOKIES_FILE=
IG_AUTH_MAX_CONTEXTS_PER_ATTEMPT=2
IG_AUTH_CONTEXT_COOLDOWN_SECONDS=900

# Latency budgets and recovery. Metadata and transfer budgets are separate.
INSTAGRAM_AUTH_FIRST_ENABLED=true
INSTAGRAM_DELIVERY_RACE_ENABLED=true
INSTAGRAM_DELIVERY_RACE_MAX_ACTIVE=2
INSTAGRAM_NORMALIZATION_CONCURRENCY=1
INSTAGRAM_AUTH_FIRST_TIMEOUT_SECONDS=20
IG_PUBLIC_METADATA_TIMEOUT_SECONDS=15
INSTAGRAM_PROVIDER_TIMEOUT_SECONDS=180
INSTAGRAM_ACQUISITION_TIMEOUT_SECONDS=300
# Preserve resolution/CRF/audio; medium restores the prior encoding preset.
INSTAGRAM_NORMALIZATION_PRESET=veryfast
IG_FAST_FAILURE_THRESHOLD=3
IG_FAST_CIRCUIT_COOLDOWN_SECONDS=300
# Zero keeps maximum available resolution / the Telegram upload-size limit.
IG_PUBLIC_MAX_HEIGHT=0
IG_PUBLIC_MAX_SOURCE_BYTES=0
# False restores larger/higher-bitrate preference at equal resolution/frame rate.
IG_PUBLIC_PREFER_SMALLER_FORMATS=true
# Prefer iOS-compatible codecs at equal resolution/frame rate to avoid transcoding.
IG_PUBLIC_PREFER_COMPATIBLE_FORMATS=true
# Shared across requests for the same Telegram bot; respects RetryAfter.
TELEGRAM_MEDIA_STAGE_CONCURRENCY=2
TELEGRAM_STATUS_TIMEOUT_SECONDS=0.5
# Synchronous admission must fail promptly on prolonged external DB contention.
SQLITE_BUSY_TIMEOUT_SECONDS=0.1

COOKIES_FILE=cookies/instagram_cookies.txt

# Proxy Configuration (optional)
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=proxy_user
# PROXY_PASSWORD=proxy_pass

# Development Mode (optional)
# DEV_MODE=false

# Logging Level (optional)
# LOG_LEVEL=INFO

# Paid true inline mode
INLINE_MODE_ENABLED=true
INLINE_SUBSCRIPTION_REQUIRED=true
INLINE_SUBSCRIPTION_STARS=1
INLINE_SUBSCRIPTION_PERIOD_SECONDS=2592000
INLINE_ONE_TIME_ENABLED=false
INLINE_ONE_TIME_STARS=1
INLINE_SESSION_TTL_SECONDS=900
INLINE_ONE_TIME_CLAIM_RECOVERY_SECONDS=21600
INLINE_STORAGE_CHAT_ID=-1001234567890
